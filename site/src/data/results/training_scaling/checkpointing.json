{
  "id": "training-checkpointing",
  "methodology": {
    "checkpointModes": {
      "always": "every patch-batch forward is wrapped in torch.utils.checkpoint, so denoiser activations are discarded and recomputed in backward",
      "auto": "wraps every batch when the rank ends up with more than one batch, that is when ceil(patches / max_batch_size) > 1, and behaves like never otherwise \u2014 so a max_batch_size large enough to hold a rank's whole patch list disables it",
      "never": "all patch-batch activations are kept for backward",
      "precondition": "gradients must be tracked; a no-grad pass checkpoints nothing regardless of the mode"
    },
    "checkpointedUnit": "one patch-batch, so max_batch_size sets how much is stored even when checkpointing is on",
    "deviceMemoryMb": 32768,
    "independentRepetitions": 1,
    "statusValues": {
      "did-not-fit": "not run: the configuration exceeds the 32768 MiB per-GPU budget. No measured numbers are attached to these entries",
      "measured": "run present in the parquet"
    }
  },
