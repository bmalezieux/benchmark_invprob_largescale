  "id": "training-batch-size",
  "methodology": {
    "baseline": {
      "gpuCount": 1,
      "maxBatchSize": 16,
      "rationale": "one baseline shared by every series, so the curves are comparable in absolute terms rather than only within a series; a per-GPU-count baseline would pin every curve to the same start and hide the batch-size effect",
      "timeSec": 91.627098
    },
    "checkpointing": "always, for every run in this experiment",
    "deviceMemoryMb": 32768,
    "efficiency": "100 x baseline step time x baselineGpuCount / (gpuCount x step time)",
    "independentRepetitions": 1,
    "maxBatchSize": "how many of a rank's patches go through the denoiser together; the patch grid is unchanged, so a step does the same total work at every batch size \u2014 this is a utilization knob, not more data"
