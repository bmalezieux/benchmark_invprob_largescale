{
  "id": "communication-inference",
  "methodology": {
    "bandwidthGBs": "implied bandwidth from transfer time and payload size; null for a single-GPU row (nothing to transfer) or where the collective count for that section cannot be derived exactly (training's backward section mixes image and parameter collectives)",
    "commEPct": "100 * sum(computeMaxSec over every section) / totalSec, where totalSec sums cudaSec over every section -- POP communication efficiency; lbCombinedPct * commEPct / 100 is parallel efficiency",
    "commEPctSection": "100 * computeMaxSec / cudaSec -- the same communication efficiency restricted to this section alone; summing numerator and denominator over every section instead gives commEPct",
    "computeMaxSec": "max over ranks of the same quantity -- the critical path",
    "computeSec": "mean over ranks of (section CUDA time - this rank's raw collective time), additive across ranks",
    "independentRepetitions": 1,
    "lbCombinedPct": "100 * sum(computeSec over every section) / sum(computeMaxSec over every section), at this gpuCount -- POP load balance for the whole study/dim, not just one section",
    "lbPct": "100 * computeSec / computeMaxSec",
    "reference": "POP methodology (https://pop-coe.eu/node/69)",
    "scaledCommSec": "(transferSec + waitSec) scaled the same way as scaledComputeSec",
    "scaledComputeSec": "computeSec * gpuCount / (baselineGpuCount * baselineTotalSec), where baseline is the smallest GPU count for this study/dim and baselineTotalSec sums cudaSec over every section at that baseline -- GPU-seconds relative to ideal linear scaling (1.0 at baseline), the same scaling the comm_share.png figure uses",
    "transferSec": "sum over collectives in the section of the per-collective min over ranks -- pure data movement",
    "waitPct": "100 * waitSec / computeSec",
    "waitSec": "mean(raw collective time) - transferSec -- average idle at collectives"
  },
